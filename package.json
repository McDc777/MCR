{
  "name": "glass-widget",
  "version": "2.4.1",
  "description": "Emerald glassmorphism desktop widget: notes, reminders, events, timer, and more. Fully offline.",
  "main": "main.js",
  "author": "Admin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.emerald.glasswidget",
    "productName": "Glass Widget",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/tray.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glass Widget"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
