<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so launch does not flash white before the
         Compose backdrop draws. -->
    <style name="Theme.McrPdfStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
